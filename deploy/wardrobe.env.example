# Copy to ~/.config/wardrobe/wardrobe.env and fill in. Keep it private (chmod 600).

# Your wardrobe folder: items/<name>/item.yaml + photos, inbox/, profile.yaml
WARDROBE_DIR=/home/YOU/wardrobe
# Runtime state (wear log, logins, caches). Default: ~/.local/state/wardrobe
#WARDROBE_STATE_DIR=/home/YOU/.local/state/wardrobe

# The public Funnel address of this machine (no trailing slash)
WARDROBE_PUBLIC_URL=https://YOUR-MACHINE.YOUR-TAILNET.ts.net

# Typed once on the login page when you add the connector in ChatGPT/Claude.
# Generate one with: uv run wardrobe secret
WARDROBE_PASSPHRASE=change-me-to-something-long

# Token the iPhone Shortcuts send to the private (tailnet-only) API.
WARDROBE_DEVICE_TOKEN=change-me-too

# Fallback location when the phone hasn't reported one recently
WARDROBE_HOME=Linköping, Sweden

# oauth (default) or none. Never use none on a Funnel-exposed machine.
#WARDROBE_AUTH=oauth

# Bind address for both apps. Keep 127.0.0.1: Tailscale proxies to it.
#WARDROBE_BIND=127.0.0.1

# Ports (Funnel → public, tailscale serve → private). Defaults shown.
#WARDROBE_PUBLIC_PORT=8765
#WARDROBE_PRIVATE_PORT=8766

# Use Arch's chromium for the link importer instead of Playwright's download
WARDROBE_CHROMIUM=/usr/bin/chromium
